# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# Put each value right after "=" with no spaces. Keep comments on their own lines.

# mock = no network, no spend. live = real calls.
PHERI_LLM_MODE=mock

# Meta Model API key (dev.meta.ai -> API keys)
MODEL_API_KEY=
# Baseten key (from the hackathon email)
BASETEN_API_KEY=
# Optional, only if Modal credits are approved
MODAL_BASE_URL=
MODAL_PROXY_TOKEN=

# Hard stop, below the $150 free credit
PHERI_META_CAP_USD=130
# Add spend made outside Pheri (dashboard Chat, Muse Code) so the cap stays honest
PHERI_META_SPEND_OFFSET_USD=0
PHERI_MAX_CALL_USD=0.50

# Neon Postgres URL; leave empty to use a local SQLite ledger
DATABASE_URL=
